    "class Cube:\n",
    "    def __init__(self, edge):\n",
    "        self.edge = edge\n",
    "    \n",
    "    def get_volume(self):\n",
    "        a = self.edge\n",
    "        return a * a * a\n",
    "        \n",
    "    \n",
    "    def get_surface_area(self):\n",
    "        a = self.edge\n",
    "        return 6 * a * a"
